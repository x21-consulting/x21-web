---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getContent, homeBase, defaultLang, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}
const { title, description, lang = defaultLang } = Astro.props;
const c = getContent(lang);
---

<BaseLayout title={`${title} — X21`} description={description} pageType="article" lang={lang}>
  <Nav home={false} lang={lang} />
  <main id="main" class="legal">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={homeBase(lang)}>{c.legal.crumbHome}</a><span aria-hidden="true">»</span><span>{title}</span>
      </nav>
      <h1 class="legal-title">{title}</h1>
      <div class="legal-body">
        <slot />
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .legal { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(4rem, 8vw, 6rem); }
  .crumbs {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--text-faint);
    margin-bottom: 2rem;
  }
  .crumbs a { color: var(--gold-dim); }
  .crumbs a:hover { color: var(--gold); }
  .legal-title {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    margin-bottom: 2.5rem;
  }
  .legal-body { max-width: 70ch; }
  .legal-body :global(h2) {
    font-size: 1.5rem;
    margin: 2.6rem 0 0.4rem;
  }
  .legal-body :global(h3) {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 2.2rem 0 0.9rem;
  }
  .legal-body :global(p) {
    color: var(--text-muted);
    margin-bottom: 1.1rem;
    font-size: 0.98rem;
  }
  .legal-body :global(strong) { color: var(--text); font-weight: 500; }
  .legal-body :global(a) { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
  .legal-body :global(ul) { color: var(--text-muted); padding-left: 1.2rem; margin-bottom: 1.1rem; }
  .legal-body :global(li) { margin-bottom: 0.5rem; }
</style>
