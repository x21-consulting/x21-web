---
import {
  getContent,
  localizePath,
  homeBase,
  getAltPath,
  defaultLang,
  type Lang,
} from '../i18n';

/** En la home los anchors funcionan; en otras páginas hay que volver al inicio */
interface Props { home?: boolean; lang?: Lang }
const { home = true, lang = defaultLang } = Astro.props;
const c = getContent(lang);
const base = homeBase(lang);

/** Resuelve el href de un item de nav según idioma y si estamos en la home. */
const resolve = (href: string) => {
  if (href.startsWith('#')) return home ? href : base + href;
  return localizePath(href, lang);
};
const contactHref = home ? '#contact' : base + '#contact';

const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const altHref = getAltPath(Astro.url.pathname, otherLang);
---

<header class="nav" id="site-nav">
  <div class="container nav-inner">
    <a class="wordmark" href={base} aria-label={c.nav.homeAria}>
      <img src="/X21_Logo_Blanco.png" alt="X21" width="936" height="394" />
    </a>

    <nav class="nav-links" aria-label="Primary">
      {c.nav.items.map((item) => (
        <a href={resolve(item.href)}>{item.label}</a>
      ))}
      <a class="btn nav-cta" href={contactHref}>{c.nav.contact}</a>
      <a
        class="lang-switch"
        href={altHref}
        data-lang-switch={otherLang}
        aria-label={c.nav.switchAria}
        title={c.nav.otherLangName}
      >{c.nav.otherLangLabel}</a>
    </nav>

    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    {c.nav.items.map((item) => (
      <a href={resolve(item.href)}>{item.label}</a>
    ))}
    <a href={contactHref}>{c.nav.contact}</a>
    <a href={c.contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    <a class="mobile-lang" href={altHref} data-lang-switch={otherLang}>{c.nav.otherLangName}</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(22, 19, 16, 0.82);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 0.5px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
  }
  .wordmark img {
    height: 26px;
    width: auto;
    display: block;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }
  .nav-links a {
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: var(--gold); }
  .nav-cta { padding: 0.5rem 1.1rem; }
  .nav-cta:hover { color: var(--bg); }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.1rem;
    padding: 0.28rem 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    font-weight: 500;
    color: var(--text-muted);
    border: 0.5px solid var(--border);
    border-radius: 4px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .lang-switch:hover { color: var(--gold); border-color: var(--gold); }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .nav-toggle span {
    width: 22px; height: 1.5px;
    background: var(--gold);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.5rem var(--gutter) 1.5rem;
    border-top: 0.5px solid var(--border);
    background: var(--bg-deep);
  }
  .mobile-menu a {
    padding: 0.7rem 0;
    color: var(--text-muted);
    border-bottom: 0.5px solid var(--border);
    font-size: 0.95rem;
  }
  .mobile-menu a:last-child { border-bottom: none; }
  .mobile-lang { color: var(--gold) !important; }

  @media (max-width: 860px) {
    .nav-links { display: none; }
    .nav-toggle { display: flex; }
  }
  @media (min-width: 861px) {
    .mobile-menu { display: none !important; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      menu.hidden = open;
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
      })
    );
  }

  // Al usar el selector EN/ES, guarda la preferencia para que se respete después.
  document.querySelectorAll('[data-lang-switch]').forEach((el) => {
    el.addEventListener('click', () => {
      try { localStorage.setItem('x21_lang', el.getAttribute('data-lang-switch') || 'en'); } catch (e) {}
    });
  });
</script>
