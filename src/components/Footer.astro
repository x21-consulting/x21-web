---
import { site } from '../data/site';
import { getContent, localizePath, defaultLang, type Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const c = getContent(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <span class="footer-mark"><img src="/X21_Logo_Blanco.png" alt="X21" width="936" height="394" /></span>
    <nav class="footer-legal" aria-label="Legal">
      {c.footer.legal.map((l) => (
        <a href={localizePath(l.href, lang)}>{l.label}</a>
      ))}
    </nav>
  </div>
  <div class="container footer-base">
    <p class="trademark">{c.footer.trademark}</p>
    <p class="copyright">© {site.legalName}, {year}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-deep);
    border-top: 0.5px solid var(--border);
    padding-block: 2.8rem 2rem;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.2rem;
    padding-bottom: 1.8rem;
    border-bottom: 0.5px solid var(--border);
  }
  .footer-mark {
    display: inline-flex;
    align-items: center;
  }
  .footer-mark img {
    height: 20px;
    width: auto;
    display: block;
    opacity: 0.85;
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
  }
  .footer-legal a {
    font-size: 0.8rem;
    color: var(--text-faint);
    transition: color 0.2s ease;
  }
  .footer-legal a:hover { color: var(--gold); }
  .footer-base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 1.6rem;
  }
  .trademark, .copyright {
    font-size: 0.78rem;
    color: var(--text-faint);
  }
</style>
