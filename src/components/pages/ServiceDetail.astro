---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { getContent, localizePath, homeBase, defaultLang, type Lang } from '../../i18n';

interface Props { lang?: Lang; slug: string }
const { lang = defaultLang, slug } = Astro.props;
const c = getContent(lang);
const base = homeBase(lang);

const block = c.services.blocks.find((b) => b.slug === slug)!;
const detail = c.services.detail;
const leaders = c.team.members.filter((m) => block.partners.includes(m.name));
const initials = (name: string) =>
  name.split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('');

const icons: Record<string, string> = {
  affairs:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M3 10h18"/><path d="M5 6l7-3 7 3"/><path d="M4 10v11"/><path d="M20 10v11"/><path d="M8 14v3"/><path d="M12 14v3"/><path d="M16 14v3"/></svg>',
  media:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/><path d="M8 21h8"/></svg>',
  risk:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>',
};
---

<BaseLayout title={`${block.title} — X21`} description={block.lead} lang={lang}>
  <Nav home={false} lang={lang} />

  <main id="main">
    <section class="svc-page">
      <div class="container">
        <header class="svc-head">
          <span class="svc-head-icon" set:html={icons[block.icon]} />
          <p class="eyebrow">{detail.eyebrow}</p>
          <h1 class="section-title">{block.title}</h1>
          <p class="svc-head-tag">{block.tagline}</p>
          <p class="lead">{block.lead}</p>
        </header>

        <div class="svc-caps">
          {block.capabilities.map((cap) => (
            <article class="svc-cap">
              <h2 class="svc-cap-title">{cap.title}</h2>
              <p class="svc-cap-body">{cap.body}</p>
            </article>
          ))}
        </div>

        {leaders.length > 0 && (
          <div class="svc-leads">
            <p class="svc-leads-label">{detail.ledBy}</p>
            <div class="svc-leads-list">
              {leaders.map((m) => (
                <a class="svc-lead" href={localizePath('/team', lang)}>
                  <span class="svc-lead-photo">
                    {m.photo
                      ? <img src={m.photo} alt={m.name} loading="lazy" />
                      : <span class="svc-lead-mono">{initials(m.name)}</span>}
                  </span>
                  <span class="svc-lead-text">
                    <span class="svc-lead-name">{m.name}</span>
                    <span class="svc-lead-title">{m.title}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="svc-cta">
          <a class="btn-dark" href={base + '#contact'}>{detail.cta}</a>
          <a class="svc-back" href={base + '#services'}>{detail.back}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .svc-page {
    --bg: #f4f0e8;
    --bg-alt: #ece7db;
    --text: #1f1b15;
    --text-muted: #6f675a;
    --text-faint: #9a9082;
    --gold: #9a7635;
    --gold-dim: #876327;
    --border: rgba(31, 27, 21, 0.14);
    background: var(--bg);
    color: var(--text);
    padding: clamp(4.5rem, 9vw, 7rem) 0 clamp(4rem, 9vw, 7rem);
    min-height: 90vh;
  }
  .svc-head { max-width: 640px; }
  .svc-head-icon { display: block; width: 38px; height: 38px; color: var(--gold); margin-bottom: 1.3rem; }
  .svc-head-icon :global(svg) { width: 100%; height: 100%; }
  .svc-head-tag { color: var(--gold-dim); font-size: 0.95rem; letter-spacing: 0.04em; margin: 0.5rem 0 0; }
  .svc-head .lead { margin-top: 1.1rem; }

  .svc-caps { margin-top: clamp(2.6rem, 6vw, 4rem); border-top: 0.5px solid var(--border); }
  .svc-cap {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 2.4rem;
    padding: 1.6rem 0;
    border-bottom: 0.5px solid var(--border);
    align-items: start;
  }
  .svc-cap-title { font-family: var(--font-display); font-size: 1.3rem; font-weight: 500; color: var(--text); margin: 0; }
  .svc-cap-body { color: var(--text-muted); font-size: 0.97rem; line-height: 1.6; margin: 0; }

  .svc-leads { margin-top: clamp(2.6rem, 6vw, 4rem); }
  .svc-leads-label { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-faint); margin: 0 0 1.2rem; }
  .svc-leads-list { display: flex; flex-wrap: wrap; gap: 2rem; }
  .svc-lead { display: flex; align-items: center; gap: 1rem; text-decoration: none; }
  .svc-lead-photo {
    width: 64px; height: 64px; border-radius: 4px; overflow: hidden;
    border: 0.5px solid var(--border); background: var(--bg-alt);
    display: flex; align-items: center; justify-content: center; flex: none;
  }
  .svc-lead-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .svc-lead-mono { font-family: var(--font-display); font-size: 1.4rem; color: var(--gold); }
  .svc-lead-name { display: block; font-family: var(--font-display); font-size: 1.2rem; color: var(--text); }
  .svc-lead-title { display: block; color: var(--text-muted); font-size: 0.85rem; margin-top: 0.1rem; }

  .svc-cta { display: flex; align-items: center; gap: 1.6rem; flex-wrap: wrap; margin-top: clamp(2.8rem, 6vw, 4rem); border-top: 0.5px solid var(--border); padding-top: clamp(2rem, 5vw, 3rem); }
  .btn-dark {
    display: inline-block; background: var(--text); color: var(--bg);
    font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 0.85rem 1.7rem; border-radius: 4px; text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .btn-dark:hover { opacity: 0.85; }
  .svc-back { color: var(--text-muted); text-decoration: none; font-size: 0.9rem; transition: color 0.2s ease; }
  .svc-back:hover { color: var(--text); }

  @media (max-width: 720px) {
    .svc-cap { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
