---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { briefing } from '../data/site';

const ENDPOINT = import.meta.env.PUBLIC_LEADS_ENDPOINT || 'https://erp.x21.consulting/api/leads';
const hasIssues = briefing.issues && briefing.issues.length > 0;
const hasArticles = briefing.articles && briefing.articles.length > 0;
---

<BaseLayout title="The Briefing — X21" description={briefing.lead}>
  <Nav home={false} />

  <main id="main">
    <section class="bp" data-endpoint={ENDPOINT}>
      <div class="container">
        <div class="bp-hero">
          <div class="bp-cover" aria-hidden="true">
            <svg viewBox="0 0 240 320" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="The Briefing — cover">
              <rect x="0" y="0" width="240" height="320" rx="6" fill="#17130e" />
              <text x="22" y="40" fill="#c9a96e" font-family="'Inter', system-ui, sans-serif" font-size="12" font-weight="600" letter-spacing="3">QUARTERLY</text>
              <text x="218" y="40" text-anchor="end" fill="#efe9dd" font-family="'Inter', system-ui, sans-serif" font-size="15" font-weight="700" letter-spacing="0.5">X21</text>
              <g fill="#efe9dd">
                <path d="M120 168 L48 120 L72 96 Z" />
                <path d="M120 168 L168 96 L192 120 Z" />
                <path d="M120 168 L192 216 L168 240 Z" />
                <path d="M120 168 L72 240 L48 216 Z" />
              </g>
              <line x1="22" y1="280" x2="218" y2="280" stroke="#4a4234" stroke-width="0.75" />
              <text x="22" y="300" fill="#b8ad99" font-family="'Inter', system-ui, sans-serif" font-size="9" font-weight="500" letter-spacing="2.5">THE BRIEFING</text>
              <text x="218" y="300" text-anchor="end" fill="#7a7060" font-family="'Inter', system-ui, sans-serif" font-size="9" letter-spacing="1">Nº 01</text>
            </svg>
          </div>

          <div class="bp-intro">
            <p class="eyebrow">{briefing.eyebrow}</p>
            <h1 class="bp-title">{briefing.title}</h1>
            {briefing.status && <p class="bp-status">{briefing.status}</p>}
            <p class="bp-lead">{briefing.lead}</p>

            <form class="bp-form" data-intent="subscribe" data-source="briefing-page" novalidate>
              <div class="bp-row">
                <input type="email" name="email" placeholder="Work email" autocomplete="email" />
                <button type="submit" class="btn-dark">Subscribe</button>
              </div>
              <div class="hp" aria-hidden="true"><label>Leave empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
              <label class="consent">
                <input type="checkbox" name="consent" />
                <span>I agree to receive the X21 Briefing and that X21 may process my email for this purpose. See our <a href="/aviso-legal">privacy policy</a>.</span>
              </label>
              <p class="form-status" role="status"></p>
            </form>
            <p class="form-thanks" hidden>Thank you — you're on the list. The next briefing will land in your inbox.</p>
          </div>
        </div>

        <div class="bp-expect">
          <p class="bp-section-label">What to expect</p>
          <div class="bp-expect-grid">
            {briefing.expect.map((e) => (
              <div class="bp-expect-item">
                <h2 class="bp-expect-title">{e.title}</h2>
                <p class="bp-expect-body">{e.body}</p>
              </div>
            ))}
          </div>
        </div>

        {hasArticles && (
          <div class="bp-writing">
            <p class="bp-section-label">Recent writing</p>
            <div class="bp-writing-list">
              {briefing.articles.map((a) => (
                <a class="bp-article" href={a.url} target="_blank" rel="noopener">
                  <h2 class="bp-article-title">{a.title}</h2>
                  <p class="bp-article-summary">{a.summary}</p>
                  <p class="bp-article-meta">{a.date} · Read on LinkedIn →</p>
                </a>
              ))}
            </div>
          </div>
        )}

        {hasIssues && (
          <div class="bp-archive">
            <p class="bp-section-label">Past issues</p>
            <div class="bp-archive-grid">
              {briefing.issues.map((it) => (
                <a class="bp-issue" href={it.href}>{it.label}</a>
              ))}
            </div>
          </div>
        )}

        <div class="bp-back">
          <a href="/">← Back home</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .bp {
    --bg: #ece6da;
    --bg-alt: #e3dccd;
    --text: #221d15;
    --text-muted: #6f675a;
    --text-faint: #9a9082;
    --gold: #8f6c2e;
    --gold-dim: #7c5d24;
    --border: rgba(31, 27, 21, 0.14);
    background: var(--bg);
    color: var(--text);
    padding: clamp(4.5rem, 9vw, 7rem) 0 clamp(4rem, 9vw, 7rem);
    min-height: 92vh;
  }

  .bp-hero { display: grid; grid-template-columns: 260px 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .bp-cover svg { display: block; width: 100%; max-width: 240px; height: auto; margin-inline: auto; filter: drop-shadow(0 12px 28px rgba(31, 27, 21, 0.20)); }
  .bp-title { font-family: var(--font-display); font-size: clamp(2.4rem, 6vw, 3.6rem); font-weight: 500; color: var(--text); margin: 0.3rem 0 0; line-height: 1.02; }
  .bp-lead { color: var(--text-muted); font-size: 1.05rem; line-height: 1.6; margin: 1.1rem 0 1.8rem; max-width: 52ch; }
  .bp-status { display: inline-block; margin: 0.9rem 0 0; font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-dim); border: 0.5px solid var(--gold-dim); border-radius: 999px; padding: 0.35rem 0.85rem; }

  .bp-writing { margin-top: clamp(3.5rem, 8vw, 6rem); }
  .bp-writing-list { border-top: 0.5px solid var(--border); }
  .bp-article { display: block; padding: 1.5rem 0; border-bottom: 0.5px solid var(--border); text-decoration: none; color: var(--text); transition: opacity 0.2s ease; }
  .bp-article:hover { opacity: 0.78; }
  .bp-article-title { font-family: var(--font-display); font-size: 1.35rem; font-weight: 500; color: var(--text); margin: 0 0 0.4rem; }
  .bp-article-summary { color: var(--text-muted); font-size: 0.95rem; line-height: 1.55; margin: 0 0 0.5rem; max-width: 70ch; }
  .bp-article-meta { font-size: 0.78rem; letter-spacing: 0.04em; color: var(--gold-dim); margin: 0; }

  .bp-row { display: flex; gap: 0.7rem; flex-wrap: wrap; max-width: 480px; }
  .bp input[type="email"] {
    flex: 1; min-width: 220px;
    background: #fbf9f4; border: 0.5px solid var(--border); border-radius: 4px;
    padding: 0.8rem 0.95rem; font: inherit; font-size: 0.95rem; color: var(--text);
  }
  .bp input[type="email"]::placeholder { color: var(--text-faint); }
  .bp input[type="email"]:focus-visible { outline: 2px solid var(--gold); outline-offset: 1px; border-color: transparent; }

  .btn-dark {
    display: inline-block; background: var(--text); color: var(--bg);
    font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 0.85rem 1.7rem; border-radius: 4px; text-decoration: none; border: none; cursor: pointer;
    white-space: nowrap; transition: opacity 0.2s ease;
  }
  .btn-dark:hover { opacity: 0.85; }
  .btn-dark:disabled { opacity: 0.5; cursor: default; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .consent { display: flex; gap: 0.6rem; align-items: flex-start; margin-top: 0.9rem; max-width: 520px; }
  .consent input { margin-top: 0.2rem; flex: none; }
  .consent span { font-size: 0.82rem; color: var(--text-muted); line-height: 1.45; }
  .consent a { color: var(--gold-dim); text-decoration: underline; }
  .form-status { margin-top: 0.6rem; font-size: 0.85rem; color: var(--text-muted); min-height: 1em; }
  .form-status.error { color: #a8392b; }
  .form-thanks { font-family: var(--font-display); font-size: 1.4rem; color: var(--text); margin: 0.6rem 0 0; }

  .bp-expect { margin-top: clamp(3.5rem, 8vw, 6rem); }
  .bp-section-label { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-faint); margin: 0 0 1.6rem; }
  .bp-expect-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4rem; border-top: 0.5px solid var(--border); padding-top: 1.8rem; }
  .bp-expect-title { font-family: var(--font-display); font-size: 1.3rem; font-weight: 500; color: var(--text); margin: 0 0 0.5rem; }
  .bp-expect-body { color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin: 0; }

  .bp-archive { margin-top: clamp(3.5rem, 8vw, 6rem); }
  .bp-archive-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.4rem; }
  .bp-issue {
    display: block; padding: 1.1rem 1.2rem; border: 0.5px solid var(--border); border-radius: 6px;
    color: var(--text); text-decoration: none; background: var(--bg-alt); transition: border-color 0.2s ease;
  }
  .bp-issue:hover { border-color: var(--gold); }

  .bp-back { margin-top: clamp(3rem, 7vw, 5rem); border-top: 0.5px solid var(--border); padding-top: 2rem; }
  .bp-back a { color: var(--text-muted); text-decoration: none; font-size: 0.9rem; }
  .bp-back a:hover { color: var(--text); }

  @media (max-width: 820px) {
    .bp-hero { grid-template-columns: 1fr; gap: 2rem; }
    .bp-cover svg { max-width: 190px; }
    .bp-expect-grid { grid-template-columns: 1fr; gap: 1.8rem; }
  }
</style>

<script>
  const form = document.querySelector('.bp-form') as HTMLFormElement | null;
  const sec = document.querySelector('.bp') as HTMLElement | null;
  const endpoint = sec ? sec.getAttribute('data-endpoint') || '' : '';
  const thanks = document.querySelector('.bp .form-thanks') as HTMLElement | null;

  const showSubscribed = () => {
    if (form) form.hidden = true;
    if (thanks) thanks.hidden = false;
  };

  try {
    if (localStorage.getItem('x21_briefing_subscribed') === '1') showSubscribed();
  } catch (e) {}

  if (form) {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const get = (n: string) => {
        const el = form.querySelector('[name="' + n + '"]') as HTMLInputElement | null;
        return el ? el.value.trim() : '';
      };
      const email = get('email');
      const consentEl = form.querySelector('[name="consent"]') as HTMLInputElement | null;
      const consent = consentEl ? consentEl.checked : false;
      const statusEl = form.querySelector('.form-status');
      const setStatus = (m: string, err: boolean) => {
        if (statusEl) { statusEl.textContent = m; statusEl.classList.toggle('error', err); }
      };

      if (!/.+@.+\..+/.test(email)) { setStatus('Please enter a valid email.', true); return; }
      if (!consent) { setStatus('Please accept the data processing notice.', true); return; }

      const payload = {
        intent: 'subscribe',
        email,
        consent: true,
        source: 'briefing-page',
        locale: 'en',
        website: get('website'),
      };

      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      setStatus('Sending…', false);
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          try { localStorage.setItem('x21_briefing_subscribed', '1'); } catch (e) {}
          showSubscribed();
        } else {
          if (btn) btn.disabled = false;
          setStatus('Something went wrong. Please try again or email us directly.', true);
        }
      } catch (e) {
        if (btn) btn.disabled = false;
        setStatus('Network error. Please try again or email us directly.', true);
      }
    });
  }
</script>
