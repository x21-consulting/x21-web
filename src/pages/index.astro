  .briefing-inner { max-width: 620px; }
  .briefing-title { font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 500; color: var(--text); margin: 0.4rem 0 0; }
  .briefing-lead { color: var(--text-muted); font-size: 1.02rem; line-height: 1.6; margin: 1rem 0 1.6rem; }
  .briefing-row { display: flex; gap: 0.7rem; flex-wrap: wrap; }
  .briefing input[type="email"] {
    flex: 1; min-width: 220px;
    background: #fbf9f4; border: 0.5px solid var(--border); border-radius: 4px;
    padding: 0.8rem 0.95rem; font: inherit; font-size: 0.95rem; color: var(--text);
  }
  .briefing input[type="email"]::placeholder { color: var(--text-faint); }
  .briefing input[type="email"]:focus-visible { outline: 2px solid var(--gold); outline-offset: 1px; border-color: transparent; }
  .briefing .btn-dark { white-space: nowrap; }
  .briefing .consent { margin-top: 0.9rem; }
  .briefing .form-status { margin-top: 0.6rem; }
  .briefing .form-thanks { margin-top: 0.5rem; }

  /* Estado suscrito: bloque compacto, sin portada/lead/formulario */
  .briefing.subscribed { padding-block: clamp(2.4rem, 5vw, 3.4rem); }
  .briefing.subscribed .briefing-grid { grid-template-columns: 1fr; gap: 0; }
  .briefing.subscribed .briefing-art,
  .briefing.subscribed .briefing-lead,
  .briefing.subscribed .briefing-form { display: none; }
