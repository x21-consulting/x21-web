---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { hero, services, team, why, contact, commitments } from '../data/site';

const ENDPOINT =
  import.meta.env.PUBLIC_LEADS_ENDPOINT || 'https://erp.x21.consulting/api/leads';
const crisisPhoneHref = 'tel:+34618780772';
const crisisPhoneLabel = '+34 618 780 772';
const crisisEmail = 'crisis@x21.consulting';

const routeIcons: Record<string, string> = {
  explore:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polygon points="15.5,8.5 10.5,10.5 8.5,15.5 13.5,13.5"/></svg>',
  diagnose:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/></svg>',
  propose:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><line x1="9" y1="12.5" x2="15" y2="12.5"/><line x1="9" y1="16" x2="15" y2="16"/></svg>',
  crisis:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5"/><line x1="5.6" y1="5.6" x2="9.5" y2="9.5"/><line x1="18.4" y1="5.6" x2="14.5" y2="9.5"/><line x1="5.6" y1="18.4" x2="9.5" y2="14.5"/><line x1="18.4" y1="18.4" x2="14.5" y2="14.5"/></svg>',
};

const icons: Record<string, string> = {
  affairs:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M3 10h18"/><path d="M5 6l7-3 7 3"/><path d="M4 10v11"/><path d="M20 10v11"/><path d="M8 14v3"/><path d="M12 14v3"/><path d="M16 14v3"/></svg>',
  media:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/><path d="M8 21h8"/></svg>',
  risk:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>',
};

const initials = (name: string) =>
  name.split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('');
---

<BaseLayout>
  <Nav />

  <main id="main">
    <!-- HERO (oscuro) -->
    <section class="hero tone-dark" id="top">
      <div class="container hero-inner">
        <p class="eyebrow">{hero.kicker}</p>
        <h1 class="hero-title">
          {hero.title.map((line, i) => (
            <span class="hero-line" style={`--d:${i * 90}ms`}>{line}</span>
          ))}
        </h1>
        <p class="hero-body">{hero.body}</p>
        <div class="hero-actions">
          <a class="btn" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        </div>
      </div>
    </section>

    <!-- SERVICES (off-white) · texto izq · imagen der -->
    <section class="feature tone-light" id="services">
      <div class="feature-text">
        <div class="feature-inner">
          <p class="eyebrow reveal">{services.eyebrow}</p>
          <h2 class="section-title reveal">{services.title}</h2>
          <p class="lead reveal">{services.lead}</p>
          <div class="svc-list">
            {services.blocks.map((b) => (
              <article class="svc-block reveal">
                <span class="svc-icon" set:html={icons[b.icon]} />
                <div>
                  <h3 class="svc-title">{b.title}</h3>
                  <p class="svc-tagline">{b.tagline}</p>
                  <ul class="svc-items">
                    {b.capabilities.map((c) => <li>{c.title}</li>)}
                  </ul>
                  <a class="svc-more" href={`/services/${b.slug}`}>Learn more →</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
      <div class="feature-media">
        <img class="parallax-img" src={services.image} alt={services.imageCaption} loading="lazy" />
      </div>
    </section>

    <!-- TEAM (crema) -->
    <section class="tone-cream" id="team">
      <div class="feature">
        <div class="feature-media">
          <img class="parallax-img" src={team.image} alt="X21 — purposeful reputation" loading="lazy" />
        </div>
        <div class="feature-text">
          <div class="feature-inner">
            <p class="eyebrow reveal">{team.eyebrow}</p>
            <h2 class="section-title reveal">{team.title}</h2>
            <p class="lead reveal">{team.lead}</p>
            <ul class="teaser-grid reveal">
              {team.members.map((m) => (
                <li class="teaser-card">
                  <div class="teaser-photo">
                    {m.photo
                      ? <img src={m.photo} alt={m.name} loading="lazy" />
                      : <span class="teaser-mono">{initials(m.name)}</span>}
                  </div>
                  <p class="teaser-name">{m.name}</p>
                  <p class="teaser-title">{m.title}</p>
                </li>
              ))}
            </ul>
            <div class="teaser-actions reveal">
              <a class="btn-dark" href="/team">Meet our partners</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY X21 (oscuro) · texto izq · imagen der -->
    <section class="feature tone-dark" id="why">
      <div class="feature-text">
        <div class="feature-inner">
          <p class="eyebrow reveal">{why.eyebrow}</p>
          <h2 class="section-title reveal">{why.title}</h2>
          <p class="lead reveal">{why.lead}</p>
          <ul class="pillars">
            {why.pillars.map((p) => (
              <li class="reveal">
                <span class="pillar-label">{p.label}</span>
                <span class="pillar-body">{p.body}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="feature-media">
        <img class="parallax-img" src={why.image} alt="X21 — communication for changing times" loading="lazy" />
      </div>
    </section>

    <!-- COMMITMENTS (oscuro) -->
    <section class="section tone-dark commitments">
      <div class="container">
        <p class="eyebrow reveal">{commitments.eyebrow}</p>
        <div class="commit-grid">
          {commitments.items.map((c) => (
            <div class="commit reveal">
              <h3 class="commit-title">{c.title}</h3>
              <p class="commit-body">{c.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- BRIEFING (crema) -->
    <section class="section tone-cream briefing" id="briefing" data-endpoint={ENDPOINT}>
      <div class="container">
        <div class="briefing-grid">
          <div class="briefing-art" aria-hidden="true">
            <svg viewBox="0 0 240 320" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="The Briefing — cover">
              <rect x="0" y="0" width="240" height="320" rx="6" fill="#17130e" />
              <text x="22" y="40" fill="#c9a96e" font-family="'Inter', system-ui, sans-serif" font-size="12" font-weight="600" letter-spacing="3">QUARTERLY</text>
              <text x="218" y="40" text-anchor="end" fill="#efe9dd" font-family="'Inter', system-ui, sans-serif" font-size="15" font-weight="700" letter-spacing="0.5">X21</text>
              <g fill="#efe9dd">
                <path d="M120 168 L48 120 L72 96 Z" />
                <path d="M120 168 L168 96 L192 120 Z" />
                <path d="M120 168 L192 216 L168 240 Z" />
                <path d="M120 168 L72 240 L48 216 Z" />
              </g>
              <line x1="22" y1="280" x2="218" y2="280" stroke="#4a4234" stroke-width="0.75" />
              <text x="22" y="300" fill="#b8ad99" font-family="'Inter', system-ui, sans-serif" font-size="9" font-weight="500" letter-spacing="2.5">THE BRIEFING</text>
              <text x="218" y="300" text-anchor="end" fill="#7a7060" font-family="'Inter', system-ui, sans-serif" font-size="9" letter-spacing="1">Nº 01</text>
            </svg>
          </div>
          <div class="briefing-inner">
            <p class="eyebrow">Quarterly</p>
            <h2 class="briefing-title">The Briefing</h2>
            <p class="briefing-lead">A quarterly briefing for senior leaders — crisis autopsies, where stakeholder expectations are shifting, and insights from our Lab. High signal, no noise.</p>
            <form class="lead-form briefing-form" data-intent="subscribe" data-source="briefing" novalidate>
              <div class="briefing-row">
                <input type="email" name="email" placeholder="Work email" autocomplete="email" />
                <button type="submit" class="btn-dark">Subscribe</button>
              </div>
              <div class="hp" aria-hidden="true"><label>Leave empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
              <label class="consent">
                <input type="checkbox" name="consent" />
                <span>I agree to receive the X21 Briefing and that X21 may process my email for this purpose. See our <a href="/aviso-legal">privacy policy</a>.</span>
              </label>
              <p class="form-status" role="status"></p>
            </form>
            <p class="form-thanks" hidden>Thank you — you're on the list. The next briefing will land in your inbox.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section contact tone-dark" id="contact" data-endpoint={ENDPOINT}>
      <div class="container">
        <p class="eyebrow">{contact.eyebrow}</p>
        <h2 class="contact-title">{contact.title}</h2>
        <p class="contact-lead">However you arrived, there's a way in — tell us what you need.</p>

        <div class="router">
          <a class="route-card" href="#services">
            <span class="route-top"><span class="route-icon" set:html={routeIcons.explore} /><span class="route-k">01</span></span>
            <span class="route-name">Explore</span>
            <span class="route-desc">See what we do and how the GERS© model works.</span>
          </a>
          <a class="route-card" href="/diagnostic">
            <span class="route-top"><span class="route-icon" set:html={routeIcons.diagnose} /><span class="route-k">02</span></span>
            <span class="route-name">Diagnose</span>
            <span class="route-desc">Get an instant reputation profile in two minutes.</span>
          </a>
          <button class="route-card" type="button" data-panel="propose">
            <span class="route-top"><span class="route-icon" set:html={routeIcons.propose} /><span class="route-k">03</span></span>
            <span class="route-name">Propose</span>
            <span class="route-desc">Tell us about a project and get a proposal.</span>
          </button>
          <button class="route-card route-crisis" type="button" data-panel="crisis">
            <span class="route-top"><span class="route-icon" set:html={routeIcons.crisis} /><span class="route-k">04</span></span>
            <span class="route-name">Crisis</span>
            <span class="route-desc">A reputational emergency that can't wait.</span>
          </button>
        </div>

        <!-- Panel: Crisis -->
        <div class="panel" id="panel-crisis" hidden>
          <div class="panel-inner">
            <div class="crisis-now">
              <p class="panel-kicker">Right now</p>
              <a class="crisis-line" href={crisisPhoneHref}>{crisisPhoneLabel}</a>
              <a class="crisis-mail" href={`mailto:${crisisEmail}`}>{crisisEmail}</a>
              <p class="crisis-note">Call or email and you reach a person, not a queue. Or leave your details and we call you back immediately.</p>
            </div>
            <form class="lead-form" data-intent="crisis" novalidate>
              <div class="fields">
                <input type="text" name="name" placeholder="Name" autocomplete="name" />
                <input type="text" name="company" placeholder="Company" autocomplete="organization" />
                <input type="tel" name="phone" placeholder="Phone" autocomplete="tel" />
                <input type="email" name="email" placeholder="Email" autocomplete="email" />
              </div>
              <textarea name="message" rows="3" placeholder="What's happening?"></textarea>
              <div class="hp" aria-hidden="true"><label>Leave empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
              <label class="consent">
                <input type="checkbox" name="consent" />
                <span>I agree that X21 may process my data to respond to my request. See our <a href="/aviso-legal">privacy policy</a>.</span>
              </label>
              <div class="form-actions">
                <button type="submit" class="btn">Request an urgent call</button>
                <p class="form-status" role="status"></p>
              </div>
            </form>
            <p class="form-thanks" hidden>Thank you — we've received your message and will contact you right away.</p>
          </div>
        </div>

        <!-- Panel: Propose -->
        <div class="panel" id="panel-propose" hidden>
          <div class="panel-inner">
            <form class="lead-form" data-intent="propose" novalidate>
              <p class="panel-kicker">Tell us about your project</p>
              <div class="fields">
                <input type="text" name="name" placeholder="Name" autocomplete="name" />
                <input type="text" name="company" placeholder="Company" autocomplete="organization" />
                <input type="email" name="email" placeholder="Work email *" autocomplete="email" />
                <input type="tel" name="phone" placeholder="Phone (optional)" autocomplete="tel" />
              </div>
              <textarea name="message" rows="4" placeholder="What would you like to achieve? Sector, challenge, timeline…"></textarea>
              <div class="hp" aria-hidden="true"><label>Leave empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
              <label class="consent">
                <input type="checkbox" name="consent" />
                <span>I agree that X21 may process my data to respond to my request. See our <a href="/aviso-legal">privacy policy</a>.</span>
              </label>
              <div class="form-actions">
                <button type="submit" class="btn">Request a proposal</button>
                <p class="form-status" role="status"></p>
              </div>
            </form>
            <p class="form-thanks" hidden>Thank you — your request is on its way. We'll be in touch shortly.</p>
          </div>
        </div>

        <div class="contact-meta">
          <a href={contact.addressUrl} target="_blank" rel="noopener"><span>Office</span>{contact.address}</a>
          <a href={`mailto:${contact.email}`}><span>Email</span>{contact.email}</a>
          <a href={contact.linkedin} target="_blank" rel="noopener"><span>Community</span>LinkedIn</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ===== Tonos por sección (sobrescriben tokens locales) ===== */
  .tone-dark { background: var(--bg); }
  .tone-light {
    --bg: #f4f0e8;
    --bg-alt: #ece7db;
    --bg-deep: #e7e1d4;
    --text: #1f1b15;
    --text-muted: #6f675a;
    --text-faint: #9a9082;
    --gold: #9a7635;
    --gold-dim: #876327;
    --border: rgba(31, 27, 21, 0.14);
    background: var(--bg);
  }
  .tone-cream {
    --bg: #e9e1d2;
    --bg-alt: #e0d7c4;
    --bg-deep: #ddd3c0;
    --text: #221d15;
    --text-muted: #6b6253;
    --text-faint: #8c8270;
    --gold: #8f6c2e;
    --gold-dim: #7a5a24;
    --border: rgba(34, 29, 21, 0.16);
    background: var(--bg);
  }

  /* ===== Feature: mitad texto / mitad imagen a sangre ===== */
  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    min-height: clamp(580px, 84vh, 940px);
    border-top: 0.5px solid var(--border);
  }
  .feature-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3rem, 6vw, 6rem) var(--gutter);
  }
  .feature-inner { width: 100%; max-width: 600px; margin-inline: auto; }
  .feature-media {
    position: relative;
    overflow: hidden;
    background: var(--bg-deep);
  }
  .parallax-img {
    position: absolute;
    left: 0;
    top: -14%;
    width: 100%;
    height: 128%;
    object-fit: cover;
    object-position: center;
    will-change: transform;
  }

  /* ===== HERO ===== */
  .hero {
    min-height: clamp(560px, 86vh, 820px);
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .hero::after,
  .hero::before {
    content: '';
    position: absolute;
    border: 0.5px solid var(--border);
    border-radius: 50%;
    pointer-events: none;
  }
  .hero::after {
    right: -8%;
    top: 50%;
    width: 46vw;
    max-width: 620px;
    aspect-ratio: 1;
    transform: translateY(-50%);
    animation: heroBreathe 17s ease-in-out infinite;
  }
  .hero::before {
    right: 6%;
    top: 30%;
    width: 26vw;
    max-width: 340px;
    aspect-ratio: 1;
    opacity: 0.7;
    animation: heroDrift 23s ease-in-out infinite;
  }
  @keyframes heroBreathe {
    0%, 100% { transform: translateY(-50%) scale(1); }
    50% { transform: translateY(-52%) scale(1.05); }
  }
  @keyframes heroDrift {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-4%, 5%); }
  }
  .hero-inner { position: relative; z-index: 1; }
  .hero-title { font-size: clamp(3.2rem, 9vw, 6.5rem); line-height: 0.98; margin: 0.4rem 0 0; }
  .hero-line {
    display: block;
    opacity: 0;
    transform: translateY(20px);
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: var(--d);
  }
  .hero-body { color: var(--text-muted); font-size: 1.1rem; max-width: 52ch; margin-top: 1.8rem; }
  .hero-actions { display: flex; align-items: center; gap: 1.8rem; margin-top: 2.4rem; flex-wrap: wrap; }
  @keyframes rise { to { opacity: 1; transform: none; } }

  /* ===== SERVICES ===== */
  .svc-list { display: flex; flex-direction: column; margin-top: 2.4rem; }
  .svc-more { display: inline-block; margin-top: 0.9rem; font-size: 0.82rem; letter-spacing: 0.06em; color: var(--gold-dim); text-decoration: none; border-bottom: 0.5px solid transparent; transition: border-color 0.2s ease; }
  .svc-more:hover { border-color: var(--gold-dim); }
  .svc-block { display: flex; gap: 1.2rem; padding: 1.5rem 0; border-top: 0.5px solid var(--border); }
  .svc-block:first-child { border-top: none; padding-top: 0; }
  .svc-icon { flex: none; width: 28px; height: 28px; color: var(--gold); margin-top: 2px; }
  .svc-icon :global(svg) { width: 100%; height: 100%; }
  .svc-title { font-family: var(--font-display); font-size: 1.45rem; font-weight: 500; color: var(--text); }
  .svc-tagline { color: var(--text-faint); font-size: 0.88rem; margin: 0.2rem 0 0.8rem; }
  .svc-items { list-style: none; margin: 0; padding: 0; }
  .svc-items li {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
    padding: 0.3rem 0 0.3rem 1.1rem;
    position: relative;
  }
  .svc-items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78rem;
    width: 5px;
    height: 5px;
    background: var(--gold-dim);
    border-radius: 50%;
  }

  /* ===== TEAM ===== */
  .quote { margin: 2.4rem 0 0; }
  .quote blockquote {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.22;
    color: var(--text);
    margin: 0 0 1.4rem;
    border-left: 1.5px solid var(--gold);
    padding-left: 1.5rem;
  }
  .quote figcaption { display: flex; flex-direction: column; gap: 0.2rem; padding-left: calc(1.5rem + 1.5px); }
  .q-author { color: var(--gold); font-size: 0.95rem; letter-spacing: 0.02em; }
  .q-role { color: var(--text-faint); font-size: 0.85rem; }

  /* ===== TEAM · teaser de socios (dentro de la columna de texto) ===== */
  .teaser-grid {
    list-style: none;
    margin: clamp(2rem, 4vw, 2.6rem) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: clamp(1.1rem, 2.4vw, 1.7rem);
  }
  .teaser-card { text-align: center; width: 104px; }
  .teaser-photo {
    width: 104px;
    height: 104px;
    border-radius: 4px;
    overflow: hidden;
    border: 0.5px solid var(--border);
    background: var(--bg-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }
  .teaser-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .teaser-mono { font-family: var(--font-display); font-size: 2.1rem; font-weight: 500; color: var(--gold); }
  .teaser-name { font-family: var(--font-display); font-size: 1.05rem; font-weight: 500; color: var(--text); margin-top: 0.55rem; line-height: 1.18; }
  .teaser-title { color: var(--gold-dim); font-size: 0.62rem; letter-spacing: 0.13em; text-transform: uppercase; margin-top: 0.28rem; }
  .teaser-actions { margin-top: clamp(1.8rem, 4vw, 2.6rem); }
  .btn-dark {
    display: inline-block;
    background: var(--text);
    color: var(--bg);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.85rem 1.7rem;
    border-radius: 4px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .btn-dark:hover { opacity: 0.85; }

  /* ===== WHY ===== */
  .pillars { list-style: none; margin: 2.4rem 0 0; padding: 0; display: flex; flex-direction: column; }
  .pillars li {
    display: grid;
    grid-template-columns: minmax(120px, 160px) 1fr;
    gap: clamp(0.8rem, 2vw, 1.6rem);
    padding: 1.3rem 0;
    border-top: 0.5px solid var(--border);
    align-items: baseline;
  }
  .pillars li:last-child { border-bottom: 0.5px solid var(--border); }
  .pillar-label { font-family: var(--font-display); font-size: 1.4rem; color: var(--text); }
  .pillar-body { color: var(--text-muted); font-size: 0.95rem; }

