  }
</style>

<script>
  // Scroll reveal
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        });
      },
      { threshold: 0.12 }
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('is-visible'));
  }

  // Parallax dentro de cada columna de imagen
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const imgs = Array.from(document.querySelectorAll<HTMLImageElement>('.parallax-img'));
  if (!reduce && imgs.length) {
    let ticking = false;
    const update = () => {
      const vh = window.innerHeight;
      for (const img of imgs) {
        const frame = img.parentElement as HTMLElement;
        const rect = frame.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > vh) continue;
        const center = rect.top + rect.height / 2;
        const progress = (center - vh / 2) / vh;
        const travel = rect.height * 0.12;
        img.style.transform = `translate3d(0, ${(-progress * travel).toFixed(1)}px, 0)`;
      }
      ticking = false;
    };
    const onScroll = () => { if (!ticking) { requestAnimationFrame(update); ticking = true; } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>

<script>
  // Router de intención: abrir panel (solo en la sección de contacto)
  const routerSection = document.querySelector('.contact');
  if (routerSection) {
    routerSection.querySelectorAll('[data-panel]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-panel');
        routerSection.querySelectorAll('.panel').forEach((p) => {
          (p as HTMLElement).hidden = p.id !== 'panel-' + target;
        });
        const panel = document.getElementById('panel-' + target);
        if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });
  }

  // Envío de formularios de lead (contacto, propuesta, crisis, briefing)
  document.querySelectorAll('.lead-form').forEach((form) => {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const intent = form.getAttribute('data-intent') || 'explore';
      const endpoint =
        (form.closest('[data-endpoint]') as HTMLElement | null)?.getAttribute('data-endpoint') || '';
      const source = form.getAttribute('data-source') || 'router-' + intent;
      const get = (n: string) => {
        const el = form.querySelector('[name="' + n + '"]') as
          | HTMLInputElement
          | HTMLTextAreaElement
          | null;
        return el ? el.value.trim() : '';
      };
      const email = get('email');
      const phone = get('phone');
      const consentEl = form.querySelector('[name="consent"]') as HTMLInputElement | null;
      const consent = consentEl ? consentEl.checked : false;
      const statusEl = form.querySelector('.form-status');
      const setStatus = (m: string, err: boolean) => {
        if (statusEl) { statusEl.textContent = m; statusEl.classList.toggle('error', err); }
      };

      const emailOk = /.+@.+\..+/.test(email);
      const reachable = emailOk || (intent === 'crisis' && phone.length >= 6);
      if (!reachable) {
        setStatus(intent === 'crisis' ? 'Add a phone or email so we can reach you.' : 'Please enter a valid email.', true);
        return;
      }
      if (!consent) { setStatus('Please accept the data processing notice.', true); return; }

      const payload = {
        intent,
        name: get('name'),
        email,
        company: get('company'),
        phone,
        message: get('message'),
        consent: true,
        source,
        locale: 'en',
        website: get('website'),
      };

      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      setStatus('Sending…', false);
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          (form as HTMLElement).hidden = true;
          const thanks = form.parentElement
            ? (form.parentElement.querySelector('.form-thanks') as HTMLElement | null)
            : null;
          if (thanks) thanks.hidden = false;
          if (intent === 'subscribe') {
            try { localStorage.setItem('x21_briefing_subscribed', '1'); } catch (e) {}
            const sec = form.closest('.briefing');
            if (sec) sec.classList.add('subscribed');
          }
        } else {
          if (btn) btn.disabled = false;
          setStatus('Something went wrong. Please try again or email us directly.', true);
        }
      } catch (e) {
        if (btn) btn.disabled = false;
        setStatus('Network error. Please try again or email us directly.', true);
      }
    });
  });

  // Recordar suscripción al briefing y colapsar el bloque en visitas posteriores
  try {
    if (localStorage.getItem('x21_briefing_subscribed') === '1') {
      const sec = document.querySelector('.briefing');
      if (sec) {
        sec.classList.add('subscribed');
        const f = sec.querySelector('.briefing-form') as HTMLElement | null;
        if (f) f.hidden = true;
        const t = sec.querySelector('.form-thanks') as HTMLElement | null;
        if (t) t.hidden = false;
      }
    }
  } catch (e) {}
</script>
