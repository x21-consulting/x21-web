---
import ServiceDetail from '../../components/pages/ServiceDetail.astro';
import { getContent } from '../../i18n';

export function getStaticPaths() {
  return getContent('en').services.blocks.map((b) => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
---

<ServiceDetail lang="en" slug={slug!} />
