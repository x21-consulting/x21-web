---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { team } from '../data/site';

const icons: Record<string, string> = {
  affairs:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M3 10h18"/><path d="M5 6l7-3 7 3"/><path d="M4 10v11"/><path d="M20 10v11"/><path d="M8 14v3"/><path d="M12 14v3"/><path d="M16 14v3"/></svg>',
  media:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/><path d="M8 21h8"/></svg>',
  risk:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>',
};

const initials = (name: string) =>
  name.split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('');
---

<BaseLayout
  title={`Our partners — ${team.title} | X21`}
  description="Meet the X21 partners — senior advisors in corporate affairs, media relations, technology and reputational crisis."
>
  <Nav home={false} />

  <main id="main">
    <section class="team-page">
      <div class="container">
        <header class="team-head">
          <p class="eyebrow">{team.eyebrow}</p>
          <h1 class="section-title">Our partners</h1>
          <p class="lead">{team.lead}</p>
        </header>

        <div class="partners-list">
          {team.members.map((m) => (
            <article class="partner">
              <div class="partner-photo">
                {m.photo
                  ? <img src={m.photo} alt={m.name} loading="lazy" />
                  : <span class="partner-mono">{initials(m.name)}</span>}
              </div>
              <div class="partner-body">
                <span class="partner-area">
                  <span class="partner-area-icon" set:html={icons[m.icon]} />{m.area}
                </span>
                <h2 class="partner-name">{m.name}</h2>
                <p class="partner-title">{m.title}</p>
                <p class="partner-bio">{m.bio}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="team-foot">
          <a class="back-link" href="/#team">← Back to home</a>
          <a class="btn-dark" href="/#contact">Start the conversation</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .team-page {
    /* tono cream definido localmente (los .tone-* viven scoped en index) */
    --bg: #e9e1d2;
    --bg-alt: #e0d7c4;
    --bg-deep: #ddd3c0;
    --text: #221d15;
    --text-muted: #6b6253;
    --text-faint: #8c8270;
    --gold: #8f6c2e;
    --gold-dim: #7a5a24;
    --border: rgba(34, 29, 21, 0.16);

    background: var(--bg);
    color: var(--text);
    padding: clamp(4.5rem, 9vw, 7rem) 0 clamp(4rem, 9vw, 7rem);
    min-height: 88vh;
  }
  .team-head {
    max-width: 720px;
    margin-bottom: clamp(2.6rem, 6vw, 4rem);
  }
  .team-head .lead { margin-top: 1.1rem; }

  .partners-list {
    display: flex;
    flex-direction: column;
    max-width: 880px;
  }
  .partner {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: 1.8rem;
    padding: 1.8rem 0;
    border-top: 0.5px solid var(--border);
    align-items: start;
  }
  .partner:first-child { border-top: none; padding-top: 0; }
  .partner-photo {
    width: 128px;
    height: 128px;
    border-radius: 4px;
    overflow: hidden;
    border: 0.5px solid var(--border);
    background: var(--bg-alt);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .partner-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .partner-mono { font-family: var(--font-display); font-size: 2.6rem; font-weight: 500; color: var(--gold); }
  .partner-area {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-dim);
  }
  .partner-area-icon { width: 15px; height: 15px; display: inline-block; color: var(--gold); }
  .partner-area-icon :global(svg) { width: 100%; height: 100%; }
  .partner-name { font-family: var(--font-display); font-size: 1.5rem; font-weight: 500; color: var(--text); margin-top: 0.55rem; }
  .partner-title { color: var(--text-faint); font-size: 0.85rem; margin-top: 0.1rem; }
  .partner-bio { color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin-top: 0.75rem; max-width: 640px; }

  .team-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.2rem;
    max-width: 880px;
    margin-top: clamp(2.6rem, 6vw, 4rem);
    padding-top: 1.8rem;
    border-top: 0.5px solid var(--border);
  }
  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }
  .back-link:hover { color: var(--text); }
  .btn-dark {
    display: inline-block;
    background: var(--text);
    color: var(--bg);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.85rem 1.7rem;
    border-radius: 4px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .btn-dark:hover { opacity: 0.85; }

  @media (max-width: 720px) {
    .partner { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
