---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const ENDPOINT =
  import.meta.env.PUBLIC_LEADS_ENDPOINT || 'https://erp.x21.consulting/api/leads';

const questions = [
  { key: 'brand', label: 'Brand', q: 'Our brand is clearly recognized and trusted in our market.' },
  { key: 'performance', label: 'Performance', q: 'We consistently deliver on the commitments we make.' },
  { key: 'transparency', label: 'Transparency', q: 'We communicate openly, even when the news is difficult.' },
  { key: 'integrity', label: 'Integrity', q: 'Our actions match the values we state publicly.' },
  { key: 'impact', label: 'Impact', q: 'We contribute positively beyond our commercial results.' },
];
---

<BaseLayout
  title="Reputation self-diagnostic — X21"
  description="Rate your organization on the five dimensions of the GERS© model and see your reputation profile instantly."
>
  <Nav home={false} />

  <main id="main">
    <section class="diag" data-endpoint={ENDPOINT}>
      <div class="container">
        <header class="diag-head">
          <p class="eyebrow">Self-diagnostic</p>
          <h1 class="section-title">How aligned is your reputation?</h1>
          <p class="lead">Rate your organization on the five dimensions of our GERS© model and see your reputation profile instantly. For a full, sector-benchmarked assessment, leave your details below.</p>
        </header>

        <div class="diag-tool">
          <div class="diag-questions">
            {questions.map((item, i) => (
              <div class="diag-row">
                <p class="diag-q">{item.q}</p>
                <div class="diag-scale">
                  <input
                    class="diag-slider"
                    type="range"
                    min="0"
                    max="100"
                    step="1"
                    value="50"
                    data-key={item.key}
                    aria-label={item.q}
                  />
                  <span class="diag-val" id={`v-${item.key}`}>50</span>
                </div>
              </div>
            ))}
          </div>

          <aside class="diag-result">
            <svg width="100%" viewBox="0 0 320 214" role="img" aria-label="Your reputation radar across five dimensions">
              <polygon points="160,44 232.3,96.5 204.7,181.5 115.3,181.5 87.7,96.5" fill="none" stroke="var(--border)" stroke-width="0.5"></polygon>
              <polygon points="160,63 214.2,102.4 193.5,166.1 126.5,166.1 105.8,102.4" fill="none" stroke="var(--border)" stroke-width="0.5"></polygon>
              <polygon points="160,82 196.1,108.3 182.3,150.7 137.7,150.7 123.9,108.3" fill="none" stroke="var(--border)" stroke-width="0.5"></polygon>
              <polygon points="160,101 178.1,114.1 171.2,135.4 148.8,135.4 141.9,114.1" fill="none" stroke="var(--border)" stroke-width="0.5"></polygon>
              <line x1="160" y1="120" x2="160" y2="44" stroke="var(--border)" stroke-width="0.5"></line>
              <line x1="160" y1="120" x2="232.3" y2="96.5" stroke="var(--border)" stroke-width="0.5"></line>
              <line x1="160" y1="120" x2="204.7" y2="181.5" stroke="var(--border)" stroke-width="0.5"></line>
              <line x1="160" y1="120" x2="115.3" y2="181.5" stroke="var(--border)" stroke-width="0.5"></line>
              <line x1="160" y1="120" x2="87.7" y2="96.5" stroke="var(--border)" stroke-width="0.5"></line>
              <polygon id="diag-poly" points="" fill="rgba(154,118,53,0.18)" stroke="var(--gold)" stroke-width="1.5" stroke-linejoin="round"></polygon>
              <circle id="dot-brand" r="2.6" fill="var(--gold)"></circle>
              <circle id="dot-performance" r="2.6" fill="var(--gold)"></circle>
              <circle id="dot-transparency" r="2.6" fill="var(--gold)"></circle>
              <circle id="dot-integrity" r="2.6" fill="var(--gold)"></circle>
              <circle id="dot-impact" r="2.6" fill="var(--gold)"></circle>
              <text x="160" y="34" text-anchor="middle" font-size="11" fill="var(--text-muted)">Brand</text>
              <text x="238" y="96" text-anchor="start" font-size="11" fill="var(--text-muted)">Performance</text>
              <text x="210" y="201" text-anchor="start" font-size="11" fill="var(--text-muted)">Transparency</text>
              <text x="110" y="201" text-anchor="end" font-size="11" fill="var(--text-muted)">Integrity</text>
              <text x="84" y="96" text-anchor="end" font-size="11" fill="var(--text-muted)">Impact</text>
            </svg>
            <div class="diag-score">
              <p class="diag-score-label">Alignment score</p>
              <p class="diag-score-num"><span id="diag-score">50</span><span class="diag-score-max">/100</span></p>
              <p class="diag-interp" id="diag-interp">A solid base, with clear room to differentiate.</p>
            </div>
          </aside>
        </div>

        <div class="diag-capture" id="diag-capture">
          <h2 class="diag-capture-title">Get your full GERS© assessment</h2>
          <p class="diag-capture-sub">Benchmarked against your sector and delivered by our team.</p>

          <div class="diag-fields">
            <input type="text" id="diag-name" placeholder="Name" autocomplete="name" />
            <input type="email" id="diag-email" placeholder="Work email *" autocomplete="email" />
            <input type="text" id="diag-company" placeholder="Company" autocomplete="organization" />
          </div>

          <div class="hp" aria-hidden="true">
            <label>Leave this field empty<input type="text" id="diag-website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <label class="diag-consent">
            <input type="checkbox" id="diag-consent" />
            <span>I agree that X21 may process my data to respond to my request. See our <a href="/aviso-legal">privacy policy</a>.</span>
          </label>

          <div class="diag-actions">
            <button type="button" id="diag-send" class="btn-dark">Send me my report</button>
            <p class="diag-status" id="diag-status" role="status"></p>
          </div>
        </div>

        <div class="diag-thanks" id="diag-thanks" hidden>
          <p class="diag-thanks-title">Thank you — your request is on its way.</p>
          <p class="diag-thanks-body">We will be in touch shortly with your full, sector-benchmarked GERS© assessment.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .diag {
    --bg: #f4f0e8;
    --bg-alt: #ece7db;
    --text: #1f1b15;
    --text-muted: #6f675a;
    --text-faint: #9a9082;
    --gold: #9a7635;
    --gold-dim: #876327;
    --border: rgba(31, 27, 21, 0.14);
    background: var(--bg);
    color: var(--text);
    padding: clamp(4.5rem, 9vw, 7rem) 0 clamp(4rem, 9vw, 7rem);
    min-height: 90vh;
  }
  .diag-head { max-width: 640px; margin-bottom: clamp(2.4rem, 6vw, 3.6rem); }
  .diag-head .lead { margin-top: 1.1rem; }

  .diag-tool {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  .diag-row { margin-bottom: 1.3rem; }
  .diag-q { font-size: 0.98rem; color: var(--text); margin: 0 0 0.5rem; line-height: 1.4; }
  .diag-scale { display: flex; align-items: center; gap: 0.9rem; }
  .diag-slider { flex: 1; min-width: 0; accent-color: var(--gold); height: 4px; }
  .diag-val { font-size: 0.85rem; font-weight: 500; min-width: 28px; text-align: right; color: var(--text-muted); }

  .diag-result { position: sticky; top: 90px; }
  .diag-score {
    margin-top: 0.8rem;
    background: var(--bg-alt);
    border-radius: 6px;
    padding: 1rem 1.2rem;
  }
  .diag-score-label { font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); margin: 0; }
  .diag-score-num { font-family: var(--font-display); font-size: 2.2rem; font-weight: 500; color: var(--text); margin: 0.1rem 0 0; }
  .diag-score-max { font-size: 1rem; color: var(--text-faint); }
  .diag-interp { font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; margin: 0.5rem 0 0; }

  .diag-capture {
    margin-top: clamp(2.6rem, 6vw, 4rem);
    max-width: 640px;
    border-top: 0.5px solid var(--border);
    padding-top: clamp(2rem, 5vw, 3rem);
  }
  .diag-capture-title { font-family: var(--font-display); font-size: 1.5rem; font-weight: 500; color: var(--text); margin: 0; }
  .diag-capture-sub { color: var(--text-muted); font-size: 0.95rem; margin: 0.4rem 0 1.4rem; }
  .diag-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  .diag-fields input { grid-column: span 1; }
  .diag-fields input[type='email'] { grid-column: 1 / -1; }
  .diag input[type='text'],
  .diag input[type='email'] {
    width: 100%;
    background: #fbf9f4;
    border: 0.5px solid var(--border);
    border-radius: 4px;
    padding: 0.75rem 0.9rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
  }
  .diag input::placeholder { color: var(--text-faint); }
  .diag input:focus-visible { outline: 2px solid var(--gold); outline-offset: 1px; border-color: transparent; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .diag-consent { display: flex; gap: 0.6rem; align-items: flex-start; margin-top: 1.1rem; font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; cursor: pointer; }
  .diag-consent input { margin-top: 0.15rem; accent-color: var(--gold); width: 16px; height: 16px; flex-shrink: 0; }
  .diag-consent a { color: var(--gold-dim); }

  .diag-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.4rem; }
  .btn-dark {
    display: inline-block;
    background: var(--text);
    color: var(--bg);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.85rem 1.7rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .btn-dark:hover { opacity: 0.85; }
  .btn-dark:disabled { opacity: 0.5; cursor: default; }
  .diag-status { font-size: 0.85rem; color: var(--text-muted); margin: 0; }
  .diag-status.error { color: #9c3a2e; }

  .diag-thanks {
    margin-top: clamp(2.6rem, 6vw, 4rem);
    max-width: 640px;
    border-top: 0.5px solid var(--border);
    padding-top: clamp(2rem, 5vw, 3rem);
  }
  .diag-thanks-title { font-family: var(--font-display); font-size: 1.6rem; font-weight: 500; color: var(--text); margin: 0 0 0.4rem; }
  .diag-thanks-body { color: var(--text-muted); font-size: 0.98rem; line-height: 1.6; margin: 0; }

  @media (max-width: 760px) {
    .diag-tool { grid-template-columns: 1fr; }
    .diag-result { position: static; max-width: 360px; }
    .diag-fields { grid-template-columns: 1fr; }
    .diag-fields input[type='email'] { grid-column: 1; }
  }
</style>

<script>
  const root = document.querySelector('.diag');
  const ENDPOINT = root ? root.getAttribute('data-endpoint') : '';
  const cx = 160, cy = 120, R = 76;
  const keys = ['brand', 'performance', 'transparency', 'integrity', 'impact'];
  const ang = (i) => ((-90 + 72 * i) * Math.PI) / 180;
  const pt = (i, v) => [cx + (R * v / 100) * Math.cos(ang(i)), cy + (R * v / 100) * Math.sin(ang(i))];

  const sliders = Array.from(document.querySelectorAll('.diag-slider'));

  function interp(s) {
    if (s < 45) return 'Significant gaps — your reputation is exposed where it matters.';
    if (s < 65) return 'A solid base, with clear room to differentiate.';
    if (s < 80) return 'Strong alignment — worth proving and protecting.';
    return 'Exceptional alignment — your reputation is a genuine asset.';
  }

  function readValues() {
    const out = {};
    sliders.forEach((s) => { out[s.dataset.key] = Number(s.value); });
    return out;
  }

  function update() {
    const vals = readValues();
    const poly = keys.map((k, i) => {
      const p = pt(i, vals[k]);
      return p[0].toFixed(1) + ',' + p[1].toFixed(1);
    }).join(' ');
    const polyEl = document.getElementById('diag-poly');
    if (polyEl) polyEl.setAttribute('points', poly);

    keys.forEach((k, i) => {
      const valEl = document.getElementById('v-' + k);
      if (valEl) valEl.textContent = String(vals[k]);
      const dot = document.getElementById('dot-' + k);
      if (dot) { const p = pt(i, vals[k]); dot.setAttribute('cx', p[0].toFixed(1)); dot.setAttribute('cy', p[1].toFixed(1)); }
    });

    const score = Math.round(keys.reduce((a, k) => a + vals[k], 0) / keys.length);
    const scoreEl = document.getElementById('diag-score');
    const interpEl = document.getElementById('diag-interp');
    if (scoreEl) scoreEl.textContent = String(score);
    if (interpEl) interpEl.textContent = interp(score);
    return { vals, score };
  }

  sliders.forEach((s) => s.addEventListener('input', update));
  update();

  const sendBtn = document.getElementById('diag-send');
  const statusEl = document.getElementById('diag-status');

  function setStatus(msg, isError) {
    if (!statusEl) return;
    statusEl.textContent = msg || '';
    statusEl.classList.toggle('error', !!isError);
  }

  if (sendBtn) {
    sendBtn.addEventListener('click', async () => {
      const email = (document.getElementById('diag-email')).value.trim();
      const consent = (document.getElementById('diag-consent')).checked;
      const website = (document.getElementById('diag-website')).value.trim();
      if (!/.+@.+\..+/.test(email)) { setStatus('Please enter a valid email.', true); return; }
      if (!consent) { setStatus('Please accept the data processing notice.', true); return; }

      const { vals, score } = update();
      const payload = {
        intent: 'diagnose',
        name: (document.getElementById('diag-name')).value.trim(),
        email,
        company: (document.getElementById('diag-company')).value.trim(),
        diagnostic: { ...vals, score },
        consent: true,
        source: 'diagnostic',
        locale: 'en',
        website,
      };

      sendBtn.disabled = true;
      setStatus('Sending…', false);
      try {
        const res = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          const capture = document.getElementById('diag-capture');
          const thanks = document.getElementById('diag-thanks');
          if (capture) capture.hidden = true;
          if (thanks) thanks.hidden = false;
        } else {
          sendBtn.disabled = false;
          setStatus('Something went wrong. Please try again or email us directly.', true);
        }
      } catch (e) {
        sendBtn.disabled = false;
        setStatus('Network error. Please try again or email us directly.', true);
      }
    });
  }
</script>
