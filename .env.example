# =============================================================================
# X21 — Variables de entorno
# Copia este archivo a `.env.local` y rellena los valores (o defínelos en Vercel
# y ejecuta `vercel env pull .env.local`). NUNCA subas `.env.local` al repo.
# =============================================================================

# -----------------------------------------------------------------------------
# CLIENTE (se incrusta en el JS del navegador → SOLO valores públicos, no secretos)
# El prefijo PUBLIC_ es obligatorio para que Astro lo exponga al cliente.
# -----------------------------------------------------------------------------

# Endpoint al que los formularios envían los datos.
# Recomendado: la función serverless de este mismo proyecto (mismo origen).
PUBLIC_LEADS_ENDPOINT="/api/lead"

# -----------------------------------------------------------------------------
# SERVIDOR (SOLO disponibles dentro de la función serverless /api/*, nunca en el
# navegador). Requieren que exista una función serverless — ver nota de arquitectura.
# NO llevan prefijo PUBLIC_.
# -----------------------------------------------------------------------------

# --- Base de datos del ERP -----------------------------------------------------
# Opción A) Conexión directa (Postgres / Supabase): cadena de conexión.
ERP_DATABASE_URL="postgres://usuario:password@host:5432/basededatos"
# Nombres de tabla (ajústalos a tu esquema del ERP)
ERP_DIAGNOSTICS_TABLE="diagnostics"
ERP_LEADS_TABLE="leads"
#
# Opción B) Si el ERP expone una API HTTP en lugar de conexión directa, usa esto
# en su lugar (y deja ERP_DATABASE_URL vacío):
# ERP_API_URL="https://erp.x21.consulting/api"
# ERP_API_TOKEN="token-secreto-del-erp"

# --- Anthropic (redacción del informe extendido) ------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
# Modelo a usar (opcional; por defecto un modelo eficiente para redacción)
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Resend (envío del email con el informe) ----------------------------------
RESEND_API_KEY="re_..."
# Remitente verificado en Resend (dominio x21.consulting)
RESEND_FROM="X21 <informe@x21.consulting>"
# Copia interna al equipo comercial cuando entra un lead (opcional)
LEAD_NOTIFICATION_EMAIL="comercial@x21.consulting"
